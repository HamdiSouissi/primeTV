# =============================================================================
# PrimeTV — variables d'environnement (copiez ce fichier vers « .env »)
#   cp .env.example .env && ./scripts/install.sh
# =============================================================================

# ---- Application ----
APP_NAME=PrimeTV
ENV=production                 # development | staging | production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8080
DOCS_ENABLED=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Sécurité (GÉNÉREZ DES VALEURS UNIQUES !) ----
# openssl rand -base64 48
SECRET_KEY=change-me-with-openssl-rand-base64-48
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOW_REGISTRATION=true
CORS_ORIGINS=*                 # en production : https://votre-domaine.tld
TRUSTED_HOSTS=*                # en production : votre-domaine.tld,localhost
SECURE_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
FORCE_HTTPS=false              # true derrière Traefik avec TLS

# ---- Base de données ----
POSTGRES_DB=primetv
POSTGRES_USER=primetv
POSTGRES_PASSWORD=change-me-postgres-password
# Pour le développement local sans Docker :
# DATABASE_URL=sqlite:///./primetv_local.db
DATABASE_URL=postgresql+psycopg://primetv:change-me-postgres-password@postgres:5432/primetv
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
AUTO_CREATE_SCHEMA=true

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# ---- Import / scan ----
HTTP_TIMEOUT_SECONDS=25
MAX_PLAYLIST_BYTES=41943040
MAX_IMPORT_CHANNELS=60000
PROBE_CONCURRENCY=8
PROBE_TIMEOUT_SECONDS=8
SCAN_MAX_CHANNELS=5000
ALLOW_PRIVATE_STREAM_HOSTS=false

# ---- Priorisation (sport & arabe en tête) ----
PRIORITY_SPORT=40
PRIORITY_ARABIC=35
PRIORITY_NEWS=20
PRIORITY_FRENCH=10

# ---- Compte initial & démo ----
DEFAULT_ADMIN_EMAIL=admin@primetv.io
DEFAULT_ADMIN_PASSWORD=PrimeTV#2026
SEED_DEMO_DATA=true

# ---- Frontend (build Vite) ----
# Laisser vide pour utiliser /api/v1 (proxy Nginx / Vite)
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://backend:8000

# ---- Traefik (profil « tls ») ----
TRAEFIK_DOMAIN=primetv.localhost
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_BASIC_AUTH_USERS=          # vide = pas d'auth ; sinon user:hash htpasswd
