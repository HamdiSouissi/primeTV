{
  "id": "/?source=pwa",
  "name": "PrimeTV — Live TV, sport & chaînes arabes",
  "short_name": "PrimeTV",
  "description": "Plateforme IPTV open source : playlists M3U/M3U8, portails Xtream, EPG XMLTV, HLS/DASH, favoris multi-profils.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
